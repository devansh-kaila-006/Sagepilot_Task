OPENAI_API_KEY=your_openai_api_key_here

# Supabase PostgreSQL Transaction Connection String
# Example: postgresql://postgres.[ref]:[password]@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=your_supabase_connection_string_here

# Model config (optional). Agent uses the flagship flash model for reliable
# tool-calling; classifier uses flash-lite (trivial task, separate quota bucket).
AGENT_MODEL=gemini-3.6-flash
CLASSIFIER_MODEL=gemini-3.1-flash-lite
